# frozen_string_literal: true

<%= header %>

module IncidentIo
  module AuditLog
    # Audit log entry types, keyed by action and version, and their models.
    ENTRIES = <%= helpers.one_per_line("{", api.audit_log_entries.map { |e| "[#{e.action.inspect}, #{e.version}] => :#{e.model}" }, "}.freeze", 4) %>
  end
end
