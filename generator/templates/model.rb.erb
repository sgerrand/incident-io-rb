# frozen_string_literal: true

<%= header %>

module IncidentIo
  module Models
<% if model.fields.empty? -%>
    <%= model.name %> = Model.define
<% else -%>
    <%= model.name %> = Model.define(
<% model.fields.each_with_index do |f, i| -%>
      <%= helpers.model_key(f.api_name) %> <%= f.type %><%= "," if i < model.fields.size - 1 %>
<% end -%>
    )
<% end -%>

<%# Reopened so YARD documents the model as a class, with its fields. -%>
<%= helpers.comment(model.description, 4) -%>
    class <%= model.name %>
<% model.fields.each do |f| -%>
      # @!attribute [r] <%= f.member %>
      #   <%= helpers.summary(f.description, "The #{f.api_name} field") %>
      #   @return [<%= f.yard %>, nil]
<% end -%>
    end
  end
end
