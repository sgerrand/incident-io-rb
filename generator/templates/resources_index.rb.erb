# frozen_string_literal: true

<%= header %>

module IncidentIo
  # API resources, one class per resource and API version. Each loads the
  # first time it is used.
  module Resources
<% api.versions.each do |version, resources| -%>
    module <%= version %>
<% resources.each do |resource| -%>
      autoload :<%= resource.class_name %>, "#{__dir__}/<%= resource.file_path %>"
<% end -%>

      # Every <%= version.downcase %> resource, e.g. `client.<%= version.downcase %>.<%= resources.first.name %>`.
      class Namespace < Resources::Namespace
<% resources.each_with_index do |resource, i| -%>
<%= "\n" if i > 0 -%>
        # The <%= version.downcase %> <%= resource.name.tr("_", " ") %> resource
        #
        # @return [<%= resource.class_name %>]
        def <%= resource.name %>
          resource(<%= resource.class_name %>)
        end
<% end -%>
      end
    end

<% end -%>
    # Resource accessors added to IncidentIo::Client. `client.<name>` is the
    # newest version of each resource; `client.v1.<name>` and so on reach a
    # specific version.
    module Accessors
<% api.versions.each_key do |version| -%>
      # Every <%= version.downcase %> resource
      #
      # @return [<%= version %>::Namespace]
      def <%= version.downcase %>
        resource_cache[:<%= version.downcase %>] ||= <%= version %>::Namespace.new(self)
      end

<% end -%>
<% api.latest_resources.each do |name, resource| -%>
      # The <%= name.tr("_", " ") %> resource, using its newest version (<%= resource.version.downcase %>)
      #
      # @return [<%= resource.version %>::<%= resource.class_name %>]
      def <%= name %>
        <%= resource.version.downcase %>.<%= name %>
      end

<% end -%>
      private

      # Version namespaces created so far, by accessor name
      #
      # @return [Hash{Symbol => Object}]
      def resource_cache
        @resource_cache ||= {}
      end
    end
  end
end
