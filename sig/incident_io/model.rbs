module IncidentIo
  # Builds immutable model classes on top of Data. Each generated model has
  # its own signature in sig/incident_io/models.
  module Model
    class MapOf < ::Data
      attr_reader type: untyped

      def self.new: (type: untyped) -> instance

      def initialize: (type: untyped) -> void
    end

    def self.map_of: (untyped type) -> MapOf

    # rbs test wraps blocks to check them, which breaks this class_eval block.
    %a{rbs:test:skip}
    def self.define: (**untyped schema) ?{ (Class klass) -> void } -> untyped

    def self.member_name: (String | Symbol api_name) -> Symbol

    def self.reserved_names: () -> Array[Symbol]

    self.@reserved_names: Array[Symbol]?

    def self.coerce: (untyped type, untyped value) -> untyped

    def self.parse_date: (untyped value) -> untyped

    # Added to every model class.
    module ClassMethods : Class
      @fields: Hash[Symbol, [String, untyped]]

      # Model fields: Ruby member name => [API field name, type].
      def fields: () -> Hash[Symbol, [String, untyped]]

      @nil_fields: Hash[Symbol, nil]

      # Every field set to nil, for fields that weren't given.
      def nil_fields: () -> Hash[Symbol, nil]

      def from_api: (untyped hash) -> untyped
    end

    # Added to every model instance.
    module InstanceMethods
      @_raw: Hash[String, untyped]?
      @_given: Set[Symbol]

      def initialize: (?raw: Hash[String, untyped]?, **untyped attrs) -> void

      # The payload this model was built from, or nil if built by hand.
      def raw: () -> Hash[String, untyped]?

      # Reads a field by its API name from the raw payload.
      def []: (String | Symbol key) -> untyped

      # A copy with some fields changed, keeping which fields were given.
      def with: (**untyped changes) -> untyped

      # A JSON-ready hash keyed by API field names. Fields that were given
      # are included, with nil as null; the rest are left out.
      def to_api: () -> Hash[String, untyped]
    end
  end
end
